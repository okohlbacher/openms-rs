# Scientific fixtures retain exact bytes on every checkout platform.
tests/data/** -text -whitespace
# Original classifier resources are byte-pinned source inputs too.
resources/metabolite_isotope_models/*.svm -text -whitespace
resources/metabolite_isotope_models/*.scale -text -whitespace

# Pinned source ontology bytes, including legacy encoding, must not be normalized.
resources/cv/*.obo -text -whitespace

# Pinned mzML semantic mapping is an original runtime resource.
resources/cv/ms-mapping.xml -text -whitespace

# Byte-pinned historical XSDs include Windows-1252 comments.
resources/schemas/*.xsd -text -whitespace
