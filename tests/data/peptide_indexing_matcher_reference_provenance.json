  "fixture": {
    "path": "tests/data/peptide_indexing_matcher_reference.tsv",
    "sha256": "302117db07ce4b9424738d12ebd3eebda0871f9312b55a2ba6f091aeb124b5b3",
    "row_count": 121
  },
  "methodology": "Independent source-reading oracle. Rows with source test origins are transcribed numeric match positions from pinned upstream tests; remaining rows are hand-traced consequences of AA lookup, stepPrimary_/stepScout_, and PeptideIndexing preprocessing. A small independent positional Python interpretation cross-checked all rows against the upstream literal expectations. No C++ code was built or executed; these are not claimed as captured C++ execution results.",
  "position_convention": "Sorted zero-based positions in the protein after removing all * characters, matching PeptideIndexing preprocessing. A dash denotes no match. Match ordering is intentionally normalized; raw AC scout visitation order is not part of this fixture.",
  "matcher_semantics": {
    "literal_case_insensitive_equality": "zero ambiguity and zero mismatch cost, including literal B/J/Z/X",
    "protein_only_expansions": {
      "B": "DN",
      "J": "IL",
      "Z": "EQ",
      "X": "22 canonical letters including O and U, excluding B/J/Z/X"
    },
    "budget": "Let A be unequal compatible protein ambiguity expansions and M all other unequal positions. Accept when M+max(0,A-max_ambiguities)<=max_mismatches.",
    "il_preprocessing": "Pinned source replaces uppercase L in peptide; uppercase L and J in protein. Peptide J is not replaced.",
    "invalid_protein_input": "AC skips nonletters other than its internal $ superAA, and C-string iteration stops at NUL. Its end-minus-needle-length offsets are wrong for matches spanning skipped bytes. PeptideIndexing removes * first and errors for [ or (; other skipped bytes are an unsafe source behavior. A checked Rust adapter should reject them or explicitly document a safer changed policy.",
    "evidence_order": "Peptide index, FASTA protein index, ascending match position, amino acid before, amino acid after. Evidence keeps actual matched positions/flanks even when enzyme validation temporarily extends an M/MX-clipped product to zero."
  },
