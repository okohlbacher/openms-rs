 "source_semantics": [
  "bulk reference set appends and permits duplicates; add ignores duplicates",
  "term value defaults all false, XML isRepeatable absent/empty true",
  "exact lowercase boolean; unknown present requirement/logic defaults MUST/OR",
  "exact qnames, ignored unrelated elements/attributes/text, one current rule within a parse",
  "successful destination loading appends references and replaces rules; scopePath unchanged"
 ],
